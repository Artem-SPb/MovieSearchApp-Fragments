<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#2A2B3D"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#3E4058"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Бейдж слоя -->
            <TextView
                android:id="@+id/tvLayerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#4CAF50"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="UI LAYER"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Имя потока -->
            <TextView
                android:id="@+id/tvThreadName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#313244"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="thread: main"
                android:textColor="#CDD6F4"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <!-- Время -->
            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="12:00:01"
                android:textColor="#7F849C"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MoviesActivity ➔ Interactor"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Описание выполнения слоя"
            android:textColor="#BAC2DE"
            android:textSize="13sp" />

        <!-- Данные payload / DTO vs Domain -->
        <LinearLayout
            android:id="@+id/layoutPayload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#181825"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Payload preview"
                android:textColor="#89DCEB"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
